# Opcional. Sin este archivo la app usa el mismo proyecto de Roble que la
# versión Flutter de Campus Innovate (`campus_innov_0ee3af93b1`), así que las
# dos comparten datos. Cópialo como `.env` solo si quieres apuntar a otro.
#
# Expo lee las variables EXPO_PUBLIC_* al arrancar `npx expo start`. Si las
# cambias, reinicia con `npx expo start --clear`.

# El host del API de Roble. Ojo: es roble-api..., no roble... (ese sirve la consola).
EXPO_PUBLIC_ROBLE_BASE_URL=https://roble-api.openlab.uninorte.edu.co

# El proyecto (contrato) de Roble.
EXPO_PUBLIC_ROBLE_CONTRACT_ID=campus_innov_0ee3af93b1

# El nombre del destino de regreso del inicio con Google en la consola de Roble.
EXPO_PUBLIC_ROBLE_SOCIAL_REDIRECT=default

# Descomenta para correr la app sin servidor, con datos de demostración.
# EXPO_PUBLIC_DATA_SOURCE=local
